# ==============================================================================
# TravelEasy - Git Ignore Rules
# ==============================================================================

# Environment and sensitive configuration
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Security certificates and keys
*.pem
*.key
*.cer
*.crt
*.der
*.p12
*.pfx
*.jks

# IDE and editor settings
.idea/
*.iml
.vscode/*
!.vscode/settings.json
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Maven & Java build artifacts
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Node & Angular build artifacts and dependencies
frontend/dist/
dist/
**/dist/
frontend/.angular/
.angular/
**/.angular/
frontend/node_modules/
node_modules/
**/node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/.tsbuildinfo

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs
logs/
**/logs/
*.log
