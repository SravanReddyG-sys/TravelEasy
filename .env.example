# ==============================================================================
# TravelEasy - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure with your actual local or staging secrets:
#
#   PowerShell (local dev):
#     Copy-Item .env.example .env
#     . .\scripts\export-env.ps1
#
#   Bash / Linux / macOS (local dev):
#     cp .env.example .env
#     source ./scripts/export-env.sh
#
#   Docker Compose:
#     docker-compose --env-file .env up -d
#
# NEVER commit your actual .env file or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Mandatory)
# ------------------------------------------------------------------------------
# MySQL root password for local MySQL / Docker container
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here

# Optional: Custom database username (default: root)
# SPRING_DATASOURCE_USERNAME=root

# Optional: Custom database host and port (default: localhost:3306)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# 2. JWT Authentication & Security (Mandatory)
# ------------------------------------------------------------------------------
# Minimum 32 characters (256 bits) secret key for HMAC-SHA256 JWT signing and verification.
# All microservices validate this key on startup. Predictable defaults are strictly prohibited.
# Generate via: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_here

# Token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway Integration (Mandatory for Payments)
# ------------------------------------------------------------------------------
# Obtain Test API Keys from Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret for signature verification (X-Razorpay-Signature)
# Configured in Razorpay Dashboard: Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. Resend Email Service Integration (Optional for local testing / Simulation)
# ------------------------------------------------------------------------------
# Obtain your API key from https://resend.com/api-keys
# When empty or omitted, Resend client logs warnings or runs in simulation mode
RESEND_API_KEY=your_resend_api_key_here

# Sender email address
# Testing mode default: Travel Easy <onboarding@resend.dev>
# Production: Use your verified domain, e.g. TravelEasy <notifications@mailer.gsrgroups.tech>
RESEND_FROM=TravelEasy <notifications@mailer.gsrgroups.tech>

# Enable email simulation in notification-service (true / false)
# When true, emails are simulated and logged without calling Resend API
RESEND_SIMULATION_ENABLED=false

# ------------------------------------------------------------------------------
# 5. Public Application URLs
# ------------------------------------------------------------------------------
# Frontend URL used for generating password reset and verification links
APP_FRONTEND_URL=http://localhost:4200

# API Gateway URL (default: http://localhost:8080/api)
API_GATEWAY_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# 6. Optional Feature Flags & Advanced Configuration
# ------------------------------------------------------------------------------
# Seat hold duration in minutes for bus bookings (default: 15)
# SEAT_HOLD_DURATION_MINUTES=15

# Transactional outbox publisher settings (defaults: enabled=true, batch-size=20, lease-seconds=60)
# BOOKING_OUTBOX_PUBLISHER_ENABLED=true
# BUS_OUTBOX_PUBLISHER_ENABLED=true
# PAYMENT_OUTBOX_PUBLISHER_ENABLED=true
# PAYMENT_WEBHOOK_RECOVERY_ENABLED=true
