# Environment Configuration Example for Travel Easy
# Copy this file to .env and provide your actual secrets.
# Never commit real credentials to version control.

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here

# Resend Email Integration Configuration
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Resend Sender Address
# In testing mode, use: Travel Easy <onboarding@resend.dev>
# For production, verify your custom domain in Resend and update here.
RESEND_FROM=Travel Easy <onboarding@resend.dev>

# Frontend Base URL (used for password reset links)
APP_FRONTEND_URL=http://localhost:4200

# Razorpay Payment Gateway Configuration (Test Mode)
# Obtain your Test API keys from Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (used for verifying X-Razorpay-Signature)
# Configured in Razorpay Dashboard: Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
